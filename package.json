{
  "name": "miaoshou-attribute-helper",
  "version": "1.0.3",
  "description": "本地妙手ERP商品必填属性自动填写助手",
  "main": "electron/main.js",
  "scripts": {
    "login": "node src/login.js",
    "fill": "node src/main.js",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "miaoshou",
    "erp",
    "playwright",
    "openai",
    "attribute"
  ],
  "author": "玖月",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "openai": "^4.76.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.miaoshou-attribute-helper",
    "productName": "妙手属性助手",
    "icon": "build/icon.ico",
    "asar": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "config/**/*",
      "!config/auth.json",
      "storage/.gitkeep",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "storage/category_attribute_knowledge.json",
        "to": "storage/category_attribute_knowledge.json",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
