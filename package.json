{
  "name": "miaoshou-attribute-helper",
  "version": "2.0.0",
  "description": "本地妙手ERP商品必填属性自动填写助手",
  "main": "electron/main.js",
  "scripts": {
    "login": "node src/login.js",
    "fill": "node src/main.js",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite --config electron/renderer/vite.config.mjs\" \"cross-env ELECTRON_IS_DEV=1 electron .\"",
    "dev:vite": "vite --config electron/renderer/vite.config.mjs",
    "build:renderer": "vite build --config electron/renderer/vite.config.mjs",
    "app": "electron .",
    "dist": "npm run build:renderer && electron-builder"
  },
  "keywords": [
    "miaoshou",
    "erp",
    "playwright",
    "openai",
    "attribute"
  ],
  "author": "玖月",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "openai": "^4.76.0",
    "playwright": "^1.49.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.local.miaoshou-attribute-helper",
    "productName": "妙手属性助手",
    "icon": "build/icon.ico",
    "asar": false,
    "files": [
      "electron/**/*",
      "!electron/renderer/src/**",
      "!electron/renderer/vite.config.mjs",
      "!electron/renderer/node_modules/**",
      "!electron/renderer/style.css",
      "!electron/renderer/app.js",
      "src/**/*",
      "config/**/*",
      "!config/auth.json",
      "storage/.gitkeep",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "storage/category_attribute_knowledge.json",
        "to": "storage/category_attribute_knowledge.json",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
